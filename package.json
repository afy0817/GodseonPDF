{
  "name": "godseon-pdf",
  "productName": "GodseonPDF",
  "version": "1.1.0",
  "description": "글자 입력, 이미지 첨부, 형광펜, 페이지 삭제를 지원하는 크로스플랫폼 PDF 편집기",
  "main": "electron/main.cjs",
  "private": true,
  "license": "MIT",
  "author": "afy0817",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/copy-assets.mjs && vite build",
    "start": "npm run build && node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/e2e.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:unit": "node --test tests/content-edit.test.mjs tests/image-export.test.mjs"
  },
  "devDependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "lucide": "1.64.0",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
